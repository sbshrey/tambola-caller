# TYPE tambola_deletion_replayed_total counter
tambola_deletion_replayed_total 2
# HELP tambola_jvm_heap_used_bytes Current used JVM heap, not retained heap after collection.
# TYPE tambola_jvm_heap_used_bytes gauge
