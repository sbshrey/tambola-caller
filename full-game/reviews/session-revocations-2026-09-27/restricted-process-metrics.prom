# HELP tambola_process_uptime_seconds Monotonic time since process monitoring started.
# TYPE tambola_process_uptime_seconds gauge
tambola_process_uptime_seconds 3.524527
# HELP tambola_worker_enabled Whether this process runs the room worker.
# TYPE tambola_worker_enabled gauge
tambola_worker_enabled 1
# HELP tambola_worker_ready Successful worker pass within 30 seconds and no later failure.
# TYPE tambola_worker_ready gauge
tambola_worker_ready 1
# HELP tambola_worker_success_age_seconds Time since complete worker pass, or -1 before the first pass.
# TYPE tambola_worker_success_age_seconds gauge
tambola_worker_success_age_seconds 0.0156605
# HELP tambola_cleanup_success_age_seconds Time since successful retention cleanup, or -1 before the first cleanup.
# TYPE tambola_cleanup_success_age_seconds gauge
tambola_cleanup_success_age_seconds 3.0764333
# HELP tambola_websocket_active Currently open room event sessions, including authentication in progress.
# TYPE tambola_websocket_active gauge
tambola_websocket_active 0
