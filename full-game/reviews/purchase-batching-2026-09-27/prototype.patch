+class QuickPurchaseBatchTest : PostgresTest() {
+    private fun id() = UUID.randomUUID().toString()
+    private fun guest() = service.register(GuestRequest("Batch QA"), id())
+    private fun prepare(actor: GuestCredentials, request: MatchRequest = MatchRequest(id(), 3)) = service.prepareQuickPurchase(actor.token, request)
+    private fun count(table: String) = database.transaction { it.query("SELECT count(*) FROM $table") { r -> r.getInt(1) }.single() }
+    private fun attempts(actor: GuestCredentials) = database.transaction { it.query("SELECT requests FROM rate_limits WHERE bucket = ?", "match:${actor.playerId}") { r -> r.getInt(1) }.single() }
+
+    @Test fun `four purchases share one top level transaction with independent exact receipts`() {
+        val actors = List(4) { guest() }; val requests = List(4) { MatchRequest(id(), it + 1) }
+        database.transaction {
+            it.execute("CREATE TABLE transaction_probe (transaction_id text)")
+            it.execute("CREATE FUNCTION probe_transaction() RETURNS trigger LANGUAGE plpgsql AS 'BEGIN INSERT INTO transaction_probe VALUES (pg_current_xact_id()::text); RETURN NEW; END;'")
+            it.execute("CREATE TRIGGER probe_transaction AFTER INSERT ON match_receipts FOR EACH ROW EXECUTE FUNCTION probe_transaction()")
+        }
+        val results = service.matchPreparedBatch(actors.mapIndexed { i, actor -> prepare(actor, requests[i]) }).map { it.getOrThrow() }
+        assertEquals(1, results.map { it.snapshot.roomId }.distinct().size)
+        assertEquals(4, count("transaction_probe"))
+        assertEquals(1, database.transaction { it.query("SELECT count(DISTINCT transaction_id) FROM transaction_probe") { r -> r.getInt(1) }.single() })
+        actors.forEachIndexed { i, actor ->
+            assertEquals(results[i], service.match(actor.token, requests[i]))
+            assertEquals(1500L - 100L * (i + 1), service.wallet(actor.token).balance)
+        }
+        assertEquals(4, count("match_receipts")); assertEquals(8, count("coin_ledger"))
+    }
