+            assertEquals(1500L, service.wallet(queued.token).balance); assertEquals(1, count("match_receipts"))
+        } finally { release.countDown(); batcher.close(); scope.cancel(); scope.coroutineContext[Job]!!.join() }
+    }
+
+    @Test fun `worker close releases queued callers and independent failures do not kill worker`() = runBlocking {
+        val actor = guest(); val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+        val entered = CompletableDeferred<Unit>(); val release = CountDownLatch(1)
+        var calls = 0
+        val batcher = QuickPurchaseBatcher(scope) { batch ->
+            if (++calls == 1) batch.map { Result.failure(ApiFailure(409, "injected", "injected")) }
+            else { entered.complete(Unit); check(release.await(5, TimeUnit.SECONDS)); service.matchPreparedBatch(batch) }
+        }
+        try {
+            try { batcher.submit(prepare(actor)); fail("Expected independent failure") } catch (error: ApiFailure) { assertEquals("injected", error.code) }
+            val active = async { batcher.submit(prepare(actor)) }
+            entered.await()
+            val queued = async(start = CoroutineStart.UNDISPATCHED) { batcher.submit(prepare(guest())) }
+            batcher.close(); release.countDown()
+            withTimeout(5_000) { active.join(); queued.join() }
+            assertTrue(active.isCancelled); assertTrue(queued.isCancelled)
+        } finally { release.countDown(); batcher.close(); scope.cancel(); scope.coroutineContext[Job]!!.join() }
+    }
