+package io.github.sbshrey.tambola.server
+
+import io.github.sbshrey.tambola.protocol.RoomUpdate
+import kotlinx.coroutines.*
+import kotlinx.coroutines.channels.Channel
+
+/** Experimental bounded grouping; the route retains its four admission permits. */
+internal class QuickPurchaseBatcher(
+    scope: CoroutineScope,
+    private val purchase: (List<RoomService.PreparedQuickPurchase>) -> List<Result<RoomUpdate>>,
+) : AutoCloseable {
+    private class Pending(val purchase: RoomService.PreparedQuickPurchase, val reply: CompletableDeferred<RoomUpdate>)
+    private val queue = Channel<Pending>(4, onUndeliveredElement = { it.reply.cancel() })
+    private val worker = scope.launch {
+        val current = mutableListOf<Pending>()
+        try {
+            for (first in queue) {
+                current += first
+                // One bounded coalescing interval, never a wait for a full batch.
+                delay(1)
+                while (current.size < 4) current += queue.tryReceive().getOrNull() ?: break
+                current.removeAll { !it.reply.isActive }
+                if (current.isNotEmpty()) {
+                    try {
+                        val results = withContext(Dispatchers.IO) { purchase(current.map { it.purchase }) }
+                        check(results.size == current.size)
+                        current.zip(results).forEach { (pending, result) ->
+                            result.fold(pending.reply::complete, pending.reply::completeExceptionally)
+                        }
+                    } catch (error: CancellationException) { throw error }
+                    catch (error: Exception) { current.forEach { it.reply.completeExceptionally(error) } }
+                }
+                current.clear()
+            }
+        } finally {
+            val stopped = CancellationException("Purchase worker stopped")
+            current.forEach { it.reply.cancel(stopped) }
+            queue.cancel(stopped)
+        }
+    }
+
+    suspend fun submit(purchase: RoomService.PreparedQuickPurchase): RoomUpdate {
+        val reply = CompletableDeferred<RoomUpdate>()
+        try { queue.send(Pending(purchase, reply)); return reply.await() }
+        finally { reply.cancel() }
+    }
+
+    override fun close() { queue.cancel(); worker.cancel() }
+}
