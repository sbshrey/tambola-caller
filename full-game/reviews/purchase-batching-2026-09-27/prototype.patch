+            it.execute("CREATE FUNCTION reject_one() RETURNS trigger LANGUAGE plpgsql AS 'BEGIN IF NEW.actor = ''${actors[2].playerId}'' THEN RAISE EXCEPTION ''injected''; END IF; RETURN NEW; END;'")
+            it.execute("CREATE TRIGGER reject_one BEFORE INSERT ON match_receipts FOR EACH ROW EXECUTE FUNCTION reject_one()")
+        }
+        val results = service.matchPreparedBatch(actors.mapIndexed { i, actor -> prepare(actor, requests[i]) })
+        assertTrue(results[0].isSuccess); assertTrue(results[3].isSuccess)
+        assertEquals("coins_low", (results[1].exceptionOrNull() as ApiFailure).code)
+        assertTrue(results[2].exceptionOrNull() is SQLException)
+        assertEquals(1, count("rooms")); assertEquals(2, count("match_receipts")); assertEquals(2, count("room_participants"))
+        assertEquals(listOf(1200L, 0L, 1500L, 1200L), actors.map { service.wallet(it.token).balance })
+        actors.forEach { assertEquals(1, attempts(it)) }
+        database.transaction { it.execute("DROP TRIGGER reject_one ON match_receipts") }
+        val retry = service.match(actors[2].token, requests[2])
+        assertEquals(retry, service.match(actors[2].token, requests[2]))
+        assertEquals(3, count("match_receipts")); assertEquals(1200L, service.wallet(actors[2].token).balance)
+    }
