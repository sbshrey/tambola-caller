+    /** Keep rejected attempts, but roll back all purchase changes before reporting their failure. */
+    private fun ratedMatch(token: String, purchase: (Connection, Guest) -> RoomUpdate): RoomUpdate {
+        val outcome = database.transaction { connection ->
+            val guest = authenticate(connection, token, lock = true)
+            rate(connection, "match:${guest.id}", 20)
+            val beforePurchase = connection.setSavepoint()
+            try {
+                Result.success(purchase(connection, guest))
+            } catch (error: Exception) {
+                connection.rollback(beforePurchase)
+                Result.failure(error)
+            } finally {
+                connection.releaseSavepoint(beforePurchase)
+            }
+        }
+        return outcome.getOrThrow()
+    }
